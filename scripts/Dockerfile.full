# Self-contained multi-stage build: frontend + backend + runtime.
# Usage:
#   docker build -f scripts/Dockerfile.full -t memos:local .

# ── Stage 1: Build frontend ──────────────────────────────────────────────────
FROM node:24-alpine AS frontend
WORKDIR /build

RUN corepack enable && corepack prepare pnpm@10 --activate

COPY web/package.json web/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY web/ ./
RUN pnpm build --mode release --outDir=/frontend-dist --emptyOutDir

# ── Stage 2: Build backend ───────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.26.1-alpine AS backend
WORKDIR /build

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
COPY --from=frontend /frontend-dist ./server/router/frontend/dist/

ARG TARGETOS TARGETARCH VERSION
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build \
      -trimpath \
      -ldflags="-s -w -X github.com/usememos/memos/internal/version.Version=${VERSION} -extldflags '-static'" \
      -tags netgo,osusergo \
      -o memos \
      ./cmd/memos

# ── Stage 3: Runtime ─────────────────────────────────────────────────────────
FROM alpine:3.21 AS runtime

RUN apk add --no-cache tzdata ca-certificates su-exec && \
    addgroup -g 10001 -S nonroot && \
    adduser -u 10001 -S -G nonroot -h /var/opt/memos nonroot && \
    mkdir -p /var/opt/memos /usr/local/memos && \
    chown -R nonroot:nonroot /var/opt/memos

COPY --from=backend /build/memos /usr/local/memos/memos
COPY --from=backend --chmod=755 /build/scripts/entrypoint.sh /usr/local/memos/entrypoint.sh

USER root
WORKDIR /var/opt/memos
VOLUME /var/opt/memos

ENV TZ="UTC" \
    MEMOS_PORT="5230"

EXPOSE 5230

ENTRYPOINT ["/usr/local/memos/entrypoint.sh", "/usr/local/memos/memos"]
